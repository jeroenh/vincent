RUN mkdir -p /home/vincent/app && \
    mkdir -p /home/vincent/app/assets

ENV APP_HOME=/home/vincent/app
WORKDIR ${APP_HOME}

ARG ASSET_PATH
#ARG API_URL
#ARG SSVC_ROLE
#ARG RECAPTCHA_SITE_KEY
#ARG TURNSTILE_SITE_KEY
