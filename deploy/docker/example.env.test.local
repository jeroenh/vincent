# Django secret keys
# If these are not set, SECRET_KEY will be generated dynamically on startup
# Key generation magic: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key().replace("$", "!"))'
#ADVISE_SECRET_KEY=
#OAUTH2PROVIDER_SECRET_KEY=

# human input validation
# One of Google RECAPTCHA or Cloudflare Turnstile must be configured for 
# input validation to function. Both have test keys available. See the
# quickstart doc in docs/ for links. Only one set of these vars should be
# set. 
#
# Google RECAPTCHA
#RECAPTCHA_SITE_KEY=
#RECAPTCHA_SECRET_KEY=
#       OR
# Cloudflare Turnstile
#TURNSTILE_SITE_KEY=
#TURNSTILE_SECRET_KEY=

# Uncomment this line to run the application tests (container exits when finished).
# To integrate with CI/CD, consider using "--exit-code-from advise" to get the exit
# code returned from the tests.
#RUN_TESTS_ONLY=vincent.wsgi